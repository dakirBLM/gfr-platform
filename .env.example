# Copy to .env for local overrides (never commit .env).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=gfr.settings.local
# Make webhook used by the authenticated Sandy feedback widget:
# SANDY_FEEDBACK_WEBHOOK_URL=https://hook.example.com/your-private-hook

# Gemini API key for Sandy's in-app chat helper (Dashboard → Sandy → Chat):
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash):
# GEMINI_MODEL=gemini-2.0-flash

# --- Production / Render + Supabase ---
# DJANGO_SETTINGS_MODULE=gfr.settings.production
# DJANGO_ALLOWED_HOSTS=your-app.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Supabase PostgreSQL connection string (Project Settings > Database):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage via S3-compatible gateway.
# Credentials: Project Settings > Storage > S3 Access Keys.
# Bucket must exist and be Public (e.g. "gfr-media") in the Supabase dashboard.
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# (or the alternate S3 host shown in the dashboard: https://<project-ref>.storage.supabase.co/storage/v1/s3)
# SUPABASE_BUCKET_NAME=gfr-media
# SUPABASE_REGION=us-east-1
# SUPABASE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/gfr-media

# Legacy options (only used when DATABASE_URL is unset):
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=/path/to/db.sqlite3
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=
# DATABASE_PORT=5432
